# Copy this file to .env and fill in FIRMS_MAP_KEY. Never commit .env.

# NASA FIRMS MAP_KEY, the only credential of the tutorial. Free, request one with your email at
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=""

# Area of interest (AOI): GADM 4.1 provinces (level 1) of a country.
# COUNTRY is the 3 letter ISO code that GADM uses, IDN for Indonesia.
# PROVINCES are the GADM province names, comma separated, with or without spaces and in any case
# (Kalimantan Barat, KalimantanBarat and kalimantan barat all work). Leave it empty ("") for the
# whole country. A wrong name stops the job with the list of the names of the country.
COUNTRY="IDN"
# The example is one province. For several, separate them with commas, e.g.
# PROVINCES="Kalimantan Tengah, Kalimantan Selatan, Riau"
PROVINCES="Kalimantan Tengah"
# Name of the AOI in the file names of the grid and figures, lower case without spaces,
# and its title on the maps
AOI_NAME="kalimantan_tengah"
AOI_TITLE="Kalimantan Tengah"

# Period of the fire alerts, both dates included
START_DATE="2026-08-01"
END_DATE="2026-10-31"

# Optional: FIRMS sources as a JSON list. NRT (near real time) covers the last months, use the
# SP (standard processing) sources such as VIIRS_SNPP_SP for older dates
# FIRMS_SOURCES='["MODIS_NRT", "VIIRS_SNPP_NRT", "VIIRS_NOAA20_NRT", "VIIRS_NOAA21_NRT"]'
